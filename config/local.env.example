# Tombwright server configuration. Copy to config/local.env on the server
# (or point TW_CONFIG_FILE at a file outside the release directory), then:
#   chown root:<php-fpm group> local.env && chmod 640 local.env
# Format: KEY=VALUE, one per line, no quotes, no spaces around "=". Never commit the copy.

TW_ENV=prod

TW_DB_HOST=127.0.0.1
TW_DB_PORT=3306
TW_DB_NAME=tombwright-db

# Least-privilege user for the web app and verifier: SELECT, INSERT, UPDATE, DELETE on tombwright-db.* only.
TW_DB_APP_USER=
TW_DB_APP_PASS=

# Separate user for bin/migrate.php only (DDL rights on tombwright-db.*). Spec §11.5.
TW_DB_MIGRATE_USER=
TW_DB_MIGRATE_PASS=
