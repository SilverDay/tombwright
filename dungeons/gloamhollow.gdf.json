    }
   ]
  },
  {
   "id": 5,
   "when": {
    "interact": "script"
   },
   "do": [
    {
     "message": "The door sinks into the floor. Cold air rises from somewhere far below."
    }
   ]
  },
  {
   "id": 6,
   "when": {
    "interact": "bell"
   },
   "repeat": true,
   "do": [
    {
