    }
   ]
  },
  {
   "id": 7,
   "when": {
    "interact": "vault"
   },
   "repeat": true,
   "do": [
    {
     "message": "The door has no handle and no keyhole. It does not move."
    }
   ]
  },
  {
   "id": 9,
   "when": {
    "doorOpen": "mWeep"
   },
   "do": [
    {
     "message": "“Weep with me, traveller, and pass,” the weeping face sighs, and its door sinks into the floor."
    }
   ]
  },
  {
   "id": 10,
   "when": {
    "doorOpen": "mLaugh"
   },
   "do": [
    {
     "message": "“Ha! Come through, come through, the way is short!” the laughing face cackles, and its door sinks into the floor."
    }
   ]
  },
  {
   "id": 11,
   "when": {
    "doorOpen": "mSleep"
   },
   "do": [
    {
     "message": "The crescent key turns. The sleeping face does not wake, but its door sinks into the floor."
    }
   ]
  },
  {
   "id": 12,
   "when": {
    "all": [
     {
      "interact": "mSleep"
     },
     {
