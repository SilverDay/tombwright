   },
   "repeat": true,
   "do": [
    {
     "message": "The sleeping face says nothing. Beneath its chin is a keyhole shaped like a crescent moon."
    }
   ]
  },
  {
   "id": 13,
   "when": {
    "all": [
     {
      "interact": "mWeep"
     },
     {
